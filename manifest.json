{
  "manifest_version": 3,
  "name": "ForcePaste: Smart Paste & Key Shield",
  "version": "1.6.0",
  "description": "Force-paste with human typing, keep tabs always active, unlock text selection & copy, and look up instant definitions & synonyms.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "clipboardRead",
    "offscreen",
    "contextMenus"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "forcepaste@sabbirxavier.github.io",
      "strict_min_version": "109.0"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page-probe.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "commands": {
    "human_paste": {
      "suggested_key": {
        "default": "Alt+V",
        "mac": "Alt+V"
      },
      "description": "Force paste clipboard into active field"
    },
    "force_copy": {
      "suggested_key": {
        "default": "Alt+C",
        "mac": "Alt+C"
      },
      "description": "Force copy clean text or extract from element"
    },
    "toggle_ghost_mode": {
      "suggested_key": {
        "default": "Alt+H",
        "mac": "Alt+H"
      },
      "description": "Toggle Ghost Mode (Hide all UI on screen)"
    }
  }
}
